{
  "name": "agentquake-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/agentquake",
    "packages/server",
    "examples/weather-agent"
  ],
  "scripts": {
    "postinstall": "npm run build -w agentquake && npm run db:generate -w @agentquake/server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @agentquake/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --type-aware packages/ examples/",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/prisma/**/*.ts\" \"packages/*/*.ts\" \"examples/*/src/**/*.ts\" \"examples/*/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/prisma/**/*.ts\" \"packages/*/*.ts\" \"examples/*/src/**/*.ts\" \"examples/*/*.ts\"",
    "start": "npm run start -w @agentquake/server",
    "start:dev": "npm run start:dev -w @agentquake/server",
    "start:debug": "npm run start:debug -w @agentquake/server",
    "start:prod": "npm run start:prod -w @agentquake/server",
    "db:generate": "npm run db:generate -w @agentquake/server",
    "db:migrate": "npm run db:migrate -w @agentquake/server --",
    "db:deploy": "npm run db:deploy -w @agentquake/server",
    "db:seed": "npm run db:seed -w @agentquake/server",
    "example": "npm run demo -w @agentquake/example-weather-agent"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
